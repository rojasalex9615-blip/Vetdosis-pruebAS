---
import "../styles/global.css";

const modules = [
  ["01", "Expediente clínico", "Pacientes, antecedentes y seguimiento en un solo lugar.", "⌕"],
  ["02", "Cálculos y dosificación", "Dosis, regla de tres, reconstitución y conversión de unidades.", "∑"],
  ["03", "Vademécum", "Fichas de fármacos y pautas de fabricante para consultar al momento.", "✚"],
  ["04", "Escáneres", "Escanea productos y etiquetas para dosis, directo a la consulta.", "▣"],
  ["05", "Agenda y consultas", "Citas y organización del día de tu clínica.", "◷"],
  ["06", "Caja e inventario", "Ventas del día, stock y alertas de caducidad.", "▤"],
  ["07", "Hospitalización", "Seguimiento de pacientes hospitalizados y sus cuidados.", "♡"],
  ["08", "Estadísticas", "Caja del periodo, citas por estado y comparación mes a mes.", "▦"],
  ["09", "Producción", "Aves de postura, porcinos y más, con registros y cálculos propios.", "⬢"]
];

const comingSoon = [
  ["✚", "Área de urgencias", "Atención de urgencias con su propio flujo dentro de la app."],
  ["✦", "Agente de IA", "Un agente que te ayuda en el día a día de tu clínica."],
  ["◈", "Pasarela de pagos", "Cobra en línea desde VetDosis Pro."],
  ["⇄", "Pagos por transferencia", "Registra pagos por transferencia, por ejemplo vía PayPal, con su recibo."],
  ["✉", "Mensajes programados por WhatsApp", "Recordatorios y avisos automáticos por WhatsApp."],
  ["⌂", "Página online gratis", "Tu clínica en línea, gratis para sucursales y hospitales."],
  ["❖", "Especialidades", "Planes por especialidad, para hospitales y para veterinarios individuales."]
];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5fb" />
    <meta name="description" content="VetDosis Pro: herramientas digitales para organizar la práctica veterinaria." />
    <title>VetDosis Pro — Tecnología para la práctica veterinaria</title>
  </head>
  <body>
    <header class="header">
      <a class="brand" href="/"> <img class="logo-img" src="/vetdosis-logo.svg" alt="VetDosis Pro" /> </a>
      <nav><a href="#herramientas">Herramientas</a><a href="#planes">Planes</a><a href="#proximamente">Próximamente</a><a href="/mapa">Mapa</a></nav>
      <a class="button button-small" href="#acceso">Conocer la plataforma ↗</a>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">TECNOLOGÍA PENSADA PARA MEDICINA VETERINARIA</p>
          <h1>Tu práctica veterinaria.<br /><em>Más conectada.</em></h1>
          <p class="lead">Herramientas para organizar la atención, consultar información y acompañar el trabajo clínico desde un mismo entorno.</p>
          <div class="actions"><a class="button" href="#herramientas">Explorar VetDosis Pro →</a><a class="quiet-link" href="#herramientas">Ver herramientas ↘</a></div>
          <p class="disclaimer">Diseñada para acompañar el trabajo veterinario, no para sustituir el criterio profesional.</p>
        </div>
        <div class="visual" aria-label="Representación conceptual de VetDosis Pro">
          <div class="glow"></div>
          <div class="window">
            <div class="window-head"><img class="logo-img logo-mini" src="/vetdosis-logo.svg" alt="VetDosis Pro" /><span class="avatar">MV</span></div>
            <p class="overline">ESPACIO DE TRABAJO</p><h2>Hola, equipo 👋</h2><p class="muted">Un vistazo a tu práctica.</p>
            <div class="stats"><div><small>AGENDA</small><b>Hoy</b><span>Organiza tus consultas</span></div><div><small>PACIENTES</small><b>Activos</b><span>Consulta expedientes</span></div></div>
            <h3>Herramientas</h3>
            <div class="tool"><i>⌕</i><span><b>Expedientes</b><small>Información clínica</small></span><strong>↗</strong></div>
            <div class="tool"><i>∑</i><span><b>Cálculos</b><small>Apoyo a la dosificación</small></span><strong>↗</strong></div>
            <div class="tool"><i>▤</i><span><b>Documentos</b><small>Recetas y formatos</small></span><strong>↗</strong></div>
          </div>
          <span class="float float-a">✳ Clínica + organización</span><span class="float float-b">✓ Enfoque veterinario</span>
        </div>
      </section>

      <section class="strip"><span>UN ENTORNO PARA EL DÍA A DÍA</span><b>Atención　·　Seguimiento　·　Organización　·　Consulta</b></section>

      <section class="section" id="herramientas">
        <div class="section-heading"><div><p class="eyebrow">UN MISMO ESPACIO, DISTINTAS TAREAS</p><h2>Todo empieza con<br /><em>una mejor organización.</em></h2></div><p>VetDosis Pro reúne herramientas que ayudan a dar estructura a distintos momentos de la práctica veterinaria.</p></div>
        <div class="grid">{modules.map(([n, title, text, sym]) => <article class="module"><div class="module-top"><span>{n}</span><span>VETDOSIS PRO</span></div><div class="symbol">{sym}</div><h3>{title}</h3><p>{text}</p><span class="arrow">↗</span></article>)}</div>
        <p class="footnote">Algunas herramientas dependen del plan que elijas.</p>
      </section>

      <section class="statement"><span>“</span><p>La tecnología debe hacer más claro el trabajo, <em>no complicarlo.</em></p><small>VETDOSIS PRO · PROPÓSITO</small></section>

      <section class="section plans" id="planes">
        <div class="plans-head">
          <p class="eyebrow">PRECIOS EN PESOS MEXICANOS</p>
          <h2>Planes claros,<br /><em>sin sorpresas.</em></h2>
          <p class="muted">Precios de lanzamiento para los primeros 100 suscritos.</p>
        </div>
        <div class="plan-cards">
          <article class="plan-card">
            <h3>Individual</h3>
            <p class="price"><b>$50</b><span> MXN/mes</span> <s>$99</s></p>
            <p class="promo-note">Precio de lanzamiento · primeros 100</p>
            <p class="plan-desc">Para el veterinario que trabaja solo, en un área.</p>
            <ul>
              <li>Calculadoras de dosis</li>
              <li>Agenda y citas</li>
              <li>Pacientes y expediente (hasta 500)</li>
              <li>Vademécum</li>
              <li>Escáner de producto y etiqueta para dosis</li>
              <li>Panel de clínica básico</li>
              <li>1 área a elegir · 1 GB de archivos</li>
            </ul>
            <p class="extensions">Extensiones: +500 pacientes $30 · +1 GB $30 · área extra $50</p>
            <a class="button" href="mailto:provetdosis@gmail.com?subject=Quiero%20probar%20VetDosis%20Pro%20-%20Plan%20Individual">Empezar prueba gratis →</a>
          </article>
          <article class="plan-card featured">
            <span class="badge">EL MÁS COMPLETO PARA UNO SOLO</span>
            <h3>Individual Completo</h3>
            <p class="price"><b>$100</b><span> MXN/mes</span> <s>$199</s></p>
            <p class="promo-note">Precio de lanzamiento · primeros 100</p>
            <p class="plan-desc">Todo lo de un veterinario solo, sin equipo.</p>
            <ul>
              <li>Todo lo del Individual</li>
              <li>Las 3 áreas: Pequeñas especies, Exóticos y Producción</li>
              <li>Hospitalización</li>
              <li>Estadísticas y comparación mes a mes</li>
              <li>Respaldo de tu clínica</li>
              <li>Hasta 5,000 pacientes · 2 GB de archivos</li>
            </ul>
            <a class="button" href="mailto:provetdosis@gmail.com?subject=Quiero%20probar%20VetDosis%20Pro%20-%20Plan%20Individual%20Completo">Empezar prueba gratis →</a>
          </article>
          <article class="plan-card">
            <h3>Clínica</h3>
            <p class="price"><b>$300</b><span> MXN/mes</span> <s>$499</s></p>
            <p class="promo-note">Precio de lanzamiento · primeros 100</p>
            <p class="plan-desc">Para clínicas con equipo.</p>
            <ul>
              <li>Todo lo del Individual Completo</li>
              <li>Equipo con roles e invitaciones</li>
              <li>Panel de clínica completo</li>
              <li>Estadísticas avanzadas</li>
              <li>Asistente de IA</li>
            </ul>
            <a class="button" href="mailto:provetdosis@gmail.com?subject=Quiero%20probar%20VetDosis%20Pro%20-%20Plan%20Cl%C3%ADnica">Empezar prueba gratis →</a>
          </article>
          <article class="plan-card wide">
            <span class="soon">PRÓXIMAMENTE</span>
            <div class="wide-copy">
              <h3>Hospital</h3>
              <p class="plan-desc">Para hospitales y grupos con varias sucursales.</p>
            </div>
            <ul>
              <li>Todo lo del plan Clínica</li>
              <li>Administración de varias sucursales</li>
              <li>Más usuarios y roles</li>
              <li>Límites ampliados</li>
            </ul>
            <a class="button" href="mailto:provetdosis@gmail.com?subject=Av%C3%ADsame%20cuando%20est%C3%A9%20listo%20VetDosis%20Pro%20-%20Plan%20Hospital">Quiero que me avisen →</a>
          </article>
        </div>
        <p class="footnote">Precios en pesos mexicanos por mes. El precio de lanzamiento se mantiene mientras tu suscripción siga activa. La prueba gratis dura 30 días.</p>
      </section>

      <section class="section" id="proximamente">
        <div class="section-heading"><div><p class="eyebrow">PRÓXIMAMENTE</p><h2>Lo que viene<br /><em>en VetDosis Pro.</em></h2></div><p>Esto es lo que estamos preparando para las próximas versiones.</p></div>
        <div class="grid">{comingSoon.map(([sym, title, text]) => <article class="module"><div class="symbol">{sym}</div><h3>{title}</h3><p>{text}</p></article>)}</div>
      </section>

      <section class="closing" id="acceso"><p class="eyebrow">VETDOSIS PRO</p><h2>El siguiente paso en tu práctica <em>empieza aquí.</em></h2><p>Prueba VetDosis Pro gratis por 30 días y elige el plan que te convenga. Escríbenos y te ayudamos a empezar.</p><a class="button button-light" href="mailto:provetdosis@gmail.com?subject=Quiero%20probar%20VetDosis%20Pro">Escríbenos: provetdosis@gmail.com ↗</a><small>Contacto oficial: provetdosis@gmail.com</small></section>
    </main>
    <footer><a class="brand" href="/"> <img class="logo-img" src="/vetdosis-logo.svg" alt="VetDosis Pro" /> </a><span>Herramientas digitales para la práctica veterinaria.</span><span>© {new Date().getFullYear()} VetDosis Pro</span></footer>
  </body>
</html>